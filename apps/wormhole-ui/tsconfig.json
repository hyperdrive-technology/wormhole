{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./app/*"
      ],
      "@wormhole/contract": [
        "../../packages/contract/src/index.ts"
      ],
      "@wormhole/migrate": [
        "../../packages/migrate/src/index.ts"
      ],
      "@wormhole/iec61131-upgrade": [
        "../../packages/iec61131-upgrade/src/index.ts"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": "."
  },
  "include": [
    "app"
  ]
}
