{
  "name": "wormhole",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r --parallel run build",
    "dev": "pnpm --filter @wormhole/ui dev",
    "test": "pnpm -r --parallel run test",
    "typecheck": "pnpm -r --parallel run typecheck",
    "generate:core-langium": "pnpm --dir \"${HYPERDRIVE_CORE_DIR:-../core}/src/typescript/packages/hyperdrive-ui\" run langium:generate",
    "test:compile-gate": "pnpm run generate:core-langium && pnpm --filter @wormhole/iec61131-upgrade run test:compile-gate",
    "test:schema-sync": "pnpm --filter @wormhole/contract exec vitest run src/schema-sync.test.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperdrive-technology/wormhole.git"
  }
}
