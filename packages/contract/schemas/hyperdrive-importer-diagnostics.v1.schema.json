{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperdrive.dev/schemas/hyperdrive-importer-diagnostics.v1.schema.json",
  "title": "Hyperdrive cloud importer diagnostics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "diagnostics"],
  "properties": {
    "schemaVersion": {
      "const": "hyperdrive.importer-diagnostics.v1"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "severity"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "(^/|(^|/)\\.\\.(/|$)|\\\\)"
                }
              },
              "startLine": {
                "type": "integer",
                "minimum": 1
              },
              "startColumn": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              },
              "endColumn": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "details": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  }
}
