{
  "name": "@wormhole/service",
  "version": "0.1.0",
  "description": "HTTP service for wormhole importers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wormhole-service": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/server.ts --format esm --dts --clean",
    "dev": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wormhole/contract": "workspace:*",
    "@wormhole/iec61131-upgrade": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26"
  }
}
