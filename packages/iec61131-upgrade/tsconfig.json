{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@wormhole/contract": ["../contract/src/index.ts"],
      "@wormhole/migrate": ["../migrate/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
