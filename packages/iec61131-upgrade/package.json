{
  "name": "@wormhole/iec61131-upgrade",
  "version": "0.1.0",
  "description": "IEC 61131 Edition 3 to Edition 4 source upgrade importer",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "wormhole": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/upgrade.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts src/upgrade.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude src/compile-gate.test.ts",
    "test:compile-gate": "vitest run src/compile-gate.test.ts"
  },
  "dependencies": {
    "@wormhole/contract": "workspace:*",
    "@wormhole/migrate": "workspace:*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26"
  }
}
