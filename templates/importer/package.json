{
  "name": "wormhole-importer-example",
  "version": "0.1.0",
  "private": true,
  "description": "Example Wormhole importer: CSV tag lists to IEC 61131-3 VAR_GLOBAL declarations",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "wormhole.importer.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wormhole/sdk": "github:hyperdrive-technology/wormhole#sdk-v0.1.0&path:/packages/sdk"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@wormhole/sdk"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
